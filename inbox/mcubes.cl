static inline 
float3 interpolate_vertex(float3 p1, float3 p2, float v1, float v2, float iso) 
{
	float w = (iso-v1)/(v2-v1);
	return mix(p1,p2,w);
//	return (1.0f-w)*p1+w*p2;
// функция p1+(p2-p1)*w == mix(p1,p2,w);
}
#define iso 0.2354f
/*! iso -- изоповерхность - константа,
	v   -- значение паратметра в вершинах кубика
 */
__kernel void marching_cubes(global float3* vertex, constant float* v/*, float iso, global float3* triangles*/) 
{
	uint gid = get_global_id(0)+get_global_id(1)*get_global_size(0);
	vertex += 12*gid;
	v += 8*gid;
	/* which vertices are inside of the surface */
	uint edges=0;
	if (v[0]<iso) edges ^= 0x0109;
	if (v[1]<iso) edges ^= 0x0203;
	if (v[2]<iso) edges ^= 0x0406;
	if (v[3]<iso) edges ^= 0x080C;

	if (v[4]<iso) edges ^= 0x1190;
	if (v[5]<iso) edges ^= 0x2230;
	if (v[6]<iso) edges ^= 0x4460;
	if (v[7]<iso) edges ^= 0x88C0;
	/* Cube is entirely in/out of the surface */
	if (edges==0) return;
	const float3 p[8] = {// definition of unit cube corners
	(float3)(0.0f, 0.0f, 0.0f),	(float3)(1.0f, 0.0f, 0.0f),	(float3)(1.0f, 0.0f, 1.0f),	(float3)(0.0f, 0.0f, 1.0f),
	(float3)(0.0f, 1.0f, 0.0f),	(float3)(1.0f, 1.0f, 0.0f),	(float3)(1.0f, 1.0f, 1.0f),	(float3)(0.0f, 1.0f, 1.0f)};
	if(edges&   1u) vertex[ 0] = interpolate_vertex(p[0], p[1], v[0], v[1], iso); 
	if(edges&   2u) vertex[ 1] = interpolate_vertex(p[1], p[2], v[1], v[2], iso);
	if(edges&   4u) vertex[ 2] = interpolate_vertex(p[2], p[3], v[2], v[3], iso);
	if(edges&   8u) vertex[ 3] = interpolate_vertex(p[3], p[0], v[3], v[0], iso);
	
	if(edges&  16u) vertex[ 4] = interpolate_vertex(p[4], p[5], v[4], v[5], iso);
	if(edges&  32u) vertex[ 5] = interpolate_vertex(p[5], p[6], v[5], v[6], iso);
	if(edges&  64u) vertex[ 6] = interpolate_vertex(p[6], p[7], v[6], v[7], iso);
	if(edges& 128u) vertex[ 7] = interpolate_vertex(p[7], p[4], v[7], v[4], iso);
	
	if(edges& 256u) vertex[ 8] = interpolate_vertex(p[0], p[4], v[0], v[4], iso);
	if(edges& 512u) vertex[ 9] = interpolate_vertex(p[1], p[5], v[1], v[5], iso);
	if(edges&1024u) vertex[10] = interpolate_vertex(p[2], p[6], v[2], v[6], iso);
	if(edges&2048u) vertex[11] = interpolate_vertex(p[3], p[7], v[3], v[7], iso);
	
   /* Create the triangle */
#if 0
	cubeindex = (edges>>8) ^ (edge>>12);
	uint ntriang = 0;
	for (long cube  = triTable[cubeindex];((cube>>0) & 0xF)!=15;cube>>=12) {
		triangles[ntriang].p[0] = vertex[(cube>>0) & 0xF];
		triangles[ntriang].p[1] = vertex[(cube>>4) & 0xF];
		triangles[ntriang].p[2] = vertex[(cube>>8) & 0xF];
		ntriang++;
	}
	return(ntriang);	
#endif
}